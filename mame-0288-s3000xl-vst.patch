+// [125A P004] Read-only visible LCD text for fail-closed original-firmware
+// capture automation. Graphic-mode pages are deliberately NOT decoded;
+// the host must never guess at their soft-key meanings.
+bool hd61830_device::snapshot_visible_text(char* dest, unsigned capacity)
+{
+	if (!dest || capacity < 321 || (m_mcr & MODE_DISPLAY_ON) == 0
+		|| (m_mcr & MODE_GRAPHIC) != 0 || m_vp <= 0 || m_hn < 40)
+		return false;
+
+	const int half_rows = m_nx / m_vp;
+	if (half_rows <= 0 || half_rows > 4)
+		return false;
+
+	for (unsigned i = 0; i != 320; ++i)
+		dest[i] = ' ';
+
+	const uint16_t start = m_dsa & 0x0fff;
+	const uint16_t lower = start + (half_rows * m_hn);
+	for (int row = 0; row < half_rows; ++row)
+	{
+		for (int x = 0; x < 40; ++x)
+		{
+			const uint8_t top = readbyte(start + row * m_hn + x);
+			const uint8_t bot = readbyte(lower + row * m_hn + x);
+			dest[row * 40 + x] = (top >= 0x20 && top <= 0x7e) ? char(top) : ' ';
+			dest[(row + half_rows) * 40 + x] =
+				(bot >= 0x20 && bot <= 0x7e) ? char(bot) : ' ';
+		}
+	}
+	dest[320] = '\0';
+	return true;
+}
