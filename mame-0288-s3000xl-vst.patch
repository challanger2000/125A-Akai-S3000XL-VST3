+	// BOTH node channels, so left and right are summed into each converter input. Thor's test tone is
+	// the same on both sides, so the sum is exactly twice the signal - and everything above full scale
+	// is then clamped, which is the clipping at a fixed +6509 / -6510 seen in the captured WAV.
+	//
+	// So the clipping was never a level his end. Naming the positions makes each mic channel match one
+	// node channel and nothing else.
+	auto &mic(MICROPHONE(config, "mic", 2));   // AINL / AINR on P16, "TO ANALOG IN PCB"
+	mic.front_left(0);
+	mic.front_right(1);
+	mic.add_route(0, m_adcfe, 1.0, 0);
+	mic.add_route(1, m_adcfe, 1.0, 1);
+
+	// DMRQ2 / DAK2 on the schematic: the PAL turns the AK5339's serial output into a DMA request,
+	// the controller reads the converter, and DACK clears the request.
+	m_maincpu->in_io16r_cb<2>().set(FUNC(s3000_state::adc_dma_r));
+	m_maincpu->out_dack_cb<2>().set(FUNC(s3000_state::adc_dack_w));
+
 	config.set_default_layout(layout_s3000xl);
 }
 
