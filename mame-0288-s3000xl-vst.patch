+	//
+	// The store side had a ceiling of its own and it was ours: DSP-DREQ3 measured EXACTLY 44100 a
+	// second in both modes, which is 33868800/768, the request period SAMPLING 87 put in the L7A1045.
+	// With the A/D free to deliver a pair the converter handed over 88200 words a second and the
+	// machine took every one, so half a stereo recording could never reach sample memory. One word per
+	// sample period is the mono case, not the part's behaviour.
+	// [SAMPLING 114] REVERTED, BY THE RULE, ON THE MEASUREMENT THAT MATTERS: THOR'S EAR.
+	//
+	// Before SAMPLING 111 and 112 the stereo recording was CLEAN and one-sided. With 111 alone (two
+	// words per frame, store still capped at 44100) it clicked and was barely audible. With 112 as well
+	// (store doubled to 88200) the clicking went but the recording came back an octave or two low. Both
+	// states are WORSE than what they replaced, so both come out, exactly as REVERT-GUESS says.
+	//
+	// What is kept is the part that was measured and costs nothing: $00C0 bit 4 is the stereo bit and
+	// bit 3 the record strobe, and the INCTL and ADC-RATE lines report them. What is dropped is every
+	// behaviour built on top of that, because the rate arguments on both sides were mine and the
+	// machine's answer to them was a worse recording.
+	//
+	// Thor's constraint, which the next attempt has to start from rather than argue with: the sampling
+	// frequency is 44.1 kHz and nothing in this machine runs at 88.2. So a stereo pair cannot be two
+	// transfers a frame on this path, and the second channel has to reach its sample some other way -
+	// which is a question about WHERE the words go, not how fast they arrive. That is a different
+	// investigation and it should start from the firmware's own de-interleave, not from another rate.
+	// [SAMPLING 122] THE STORE HEADROOM, AND THIS TIME ONLY BETWEEN THE STROBE EDGES.
+	//
+	// SAMPLING 112 raised the L7A1045 request rate from every write to $00C0 and left it raised until
+	// the next one, which is far wider than a recording, and it re-armed transfers that were already
+	// running. That build produced the octave and was reverted. The measured need is narrow: with the
+	// right word handed over, 88200 words a second arrive during a STEREO recording while the store is
+	// capped at 33868800/768 = 44100, so exactly half of it can never land - which is the clicking and
+	// the missing right side Thor heard from the SAMPLING 119 build.
+	//
+	// So it moves on the STROBE EDGES and nowhere else: up when a stereo recording starts, back to 1
+	// when it ends. Mono never touches it, and neither does any other write to this latch.
+	// See the edge handling below.
+
+	if ((prev ^ data) & 0x1e)
+		S3000_LOG("INCTL $00C0 = %02X  STROBE=%d STEREO=%d  pc=%05X t=%.5f\n",
+			data, BIT(data, 3), BIT(data, 4), m_maincpu->pc(),
+			machine().time().as_double());
+
+	// The strobe is documented as "input control strobe or reset". Taking it as the start of a
+	// transfer, it is the natural place to put the channel phase back to a known state - so a
+	// recording begins on the first enabled channel rather than wherever the previous one stopped.
+	// [SAMPLING 117] arm on the strobe, report on its fall - no budget to be spent by the boot.
+	if (BIT(data, 3) != BIT(prev, 3))
+	{
+		if (BIT(data, 3))
+		{
+			// [SAMPLING 122] see the note above - the headroom exists only inside a stereo recording.
+			if (m_dsp)
+				m_dsp->set_dma_words_per_frame(m_adc_stereo ? 2 : 1);
+			for (auto &e : m_ringrd)
+				e = ring_reader();       // [SAMPLING 118] clear the ENTRIES, not just the count
+			m_ringrd_n = 0;
+			m_ringrd_dropped = 0;
+			m_rec_was_stereo = m_adc_stereo;   // latched here, not read at the report
+			m_rec_active = true;
+		}
+		else
+		{
+			if (m_dsp)
+				m_dsp->set_dma_words_per_frame(1);   // [SAMPLING 122] back to the default at the end
+			m_rec_active = false;
+			m_blockreq_until = machine().time().as_double() + 3.0;   // [SAMPLING 143]
+			S3000_LOG("RINGRD %s recording ended - %u distinct readers%s:\n",
+				m_rec_was_stereo ? "STEREO" : "MONO", m_ringrd_n,
+				m_ringrd_dropped ? "  (MORE THAN SIXTEEN - some were dropped)" : "");
+			// Loudest first, and only the ones that read enough to have a stride worth naming.
+			uint32_t order[16];
+			for (uint32_t i = 0; i < m_ringrd_n; i++) order[i] = i;
+			for (uint32_t i = 0; i < m_ringrd_n; i++)
+				for (uint32_t j = i + 1; j < m_ringrd_n; j++)
+					if (m_ringrd[order[j]].n > m_ringrd[order[i]].n) std::swap(order[i], order[j]);
+			for (uint32_t k = 0; k < m_ringrd_n; k++)
+			{
+				const ring_reader &e = m_ringrd[order[k]];
+				if (e.n < 8)
+					continue;
+				logerror("  RINGRD pc=%06X  reads %llu  stride+2 %u (%.1f%%)  stride+4 %u (%.1f%%)  other %u  worst %d\n",
+					e.pc, (unsigned long long)e.n,
