+uint16_t s3000_state::sampctrl_r(offs_t offset, uint16_t mem_mask)
+{
+	offset &= 0x1f;
+
+	// [SAMPLING 73] AN OVERRIDE, FOUND WHILE LOOKING FOR SOMETHING ELSE - and $C004 is the very port
+	// the firmware reads the DMA's current address from (in ax,C004h in the routine dumped at 0271B0).
+	// A handler that returns a value computed from machine().time() is a fabrication by the definition
+	// this project settled on after the Virus: an override is any handler that assigns to data or
+	// returns a computed value. Five of those cost that project months.
+	//
+	// It is very probably dead - the V53's internal peripherals are decoded before the external I/O
+	// map, and DMA-READS proves the DMAU is what answers there - but "probably dead" is not a
+	// measurement. This says so out loud if it is ever reached, once, and then behaves as before.
+	if (offset == 2 && m_sampsel == 0)      // 0xC004 - the page position counter
+	{
+		static bool warned = false;
+		if (!warned)
+		{
+			warned = true;
+			S3000_LOG("SAMPCTRL-OVERRIDE $C004 was READ THROUGH THE EXTERNAL MAP - this fabricates a "
+				"counter from machine time on the port the firmware uses for the DMA address  pc=%06X t=%.5f\n",
+				m_maincpu->pc(), machine().time().as_double());
+		}
+		const uint64_t ticks = uint64_t(machine().time().as_double() * 44100.0);
+		return uint16_t(ticks & 0x3ff);
+	}
+
+	uint16_t data = m_sampctrl[offset];
+	if (offset == 0)
+		data = (data & 0x00ff) | (uint16_t(m_sampsel) << 8);
+
+	static std::set<uint32_t> seen;
+	const uint32_t key = (uint32_t(m_maincpu->pc()) << 8) | uint32_t(offset);
+	if (seen.size() < 64 && seen.insert(key).second)
+		S3000_LOG("SAMPCTRL-R $%04X -> %04X  mask=%04X pc=%05X t=%.4f\n",
+			0xc000 + offset * 2, data, mem_mask, m_maincpu->pc(), machine().time().as_double());
+	return data;
+}
+
+void s3000_state::sampctrl_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	offset &= 0x1f;
+	COMBINE_DATA(&m_sampctrl[offset]);
+
+	if (offset == 0 && ACCESSING_BITS_8_15)   // 0xC001 - counter select
+		m_sampsel = uint8_t(data >> 8);
+
+	static std::set<uint64_t> seen;
+	const uint64_t key = (uint64_t(m_maincpu->pc()) << 24) | (uint64_t(offset) << 16) | (data & 0xffff);
+	if (seen.size() < 96 && seen.insert(key).second)
+		S3000_LOG("SAMPCTRL-W $%04X = %04X  mask=%04X pc=%05X t=%.4f%s\n",
+			0xc000 + offset * 2, data, mem_mask, m_maincpu->pc(), machine().time().as_double(),
+			(offset == 1) ? "   <<<< length (written as min(len,0x400)-1)" :
+			(offset == 0 && ACCESSING_BITS_8_15) ? "   <<<< counter select" : "");
+}
