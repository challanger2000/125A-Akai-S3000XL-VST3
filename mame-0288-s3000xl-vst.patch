+TIMER_CALLBACK_MEMBER(s3000_state::pcsample_tick)
+{
+	static std::map<uint32_t, uint32_t> hist;
+	static uint32_t n = 0;
+	++hist[m_maincpu->pc()];
+	if ((++n % 2000) == 0)
+	{
+		std::vector<std::pair<uint32_t, uint32_t>> v(hist.begin(), hist.end());
+		std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.second > b.second; });
+		std::string top;
+		for (size_t i = 0; i < v.size() && i < 8; i++)
+			top += util::string_format("%06X=%u ", v[i].first, v[i].second);
+		// [SAMPLING 74] THE ONE NUMBER THAT CANNOT BE MISREAD - cycles actually executed per emulated
+		// second, against the 32 MHz this CPU is configured at.
+		//
+		// The pc histogram cannot be trusted and this is why: its profile is IDENTICAL before, during
+		// and after a recording - same addresses, same shares - and the polling loop at 0271BC, which
+		// is measured running hundreds of thousands of times a second, never appears in it at all. A
+		// periodic 2 kHz timer can lock to the phase of MAME's timeslices and then always sample the
+		// same point, which is aliasing rather than measurement. Seventh instrument this session whose
+		// reading was shaped by its own construction, and it stays only because the cycle count below
+		// costs nothing to carry alongside it.
+		//
+		// What IS established: the emulation runs at real time (the host ring reports ratio 0.996 to
+		// 1.03), so the ten to thirty seconds Thor watches the waveform draw is EMULATED time. The
+		// machine really is that slow at it. Either the V53 is executing far fewer cycles a second than
+		// its clock implies - the DMA holding the bus, wait states, something taking the processor away
+		// - or it is genuinely executing thirty times the work, which would make the slow drawing a
+		// consequence of the copy loop re-reading rather than its cause.
+		//
+		// total_cycles() separates those two outright, with no threshold and no sampling.
+		static uint64_t last_cycles = 0;
+		const uint64_t cyc = m_maincpu->total_cycles();
+		S3000_LOG("CPU-CYCLES %llu executed in the last second, against 32000000 at the configured clock  (%.1f%%)\n",
+			(unsigned long long)(cyc - last_cycles), (cyc - last_cycles) * 100.0 / 32000000.0);
+		last_cycles = cyc;
+
+		S3000_LOG("PCHIST 2000 samples over 1 s, %u distinct: %s t=%.2f\n",
+			unsigned(v.size()), top, machine().time().as_double());
+		hist.clear();
+	}
+}
