+void s3000_state::inctl_w(uint8_t data)
+{
+	const uint8_t prev = m_inctl;
+	m_inctl = data;
+
+	// [125A P002] Expose the firmware's actual WADCS port-A writes to
+	// the VST host. No inferred bit meanings in the MAME driver: the
+	// callback forwards the complete original latch value unmodified.
+	// An output event is rare (control transitions only), never per DMA word.
+	if (prev != data)
+		machine().output().set_value("s3000xl_wadcs", data);
