+void s3000_state::unmapped_io_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	static std::set<uint64_t> seen;
+	const uint16_t port = uint16_t(offset * 2);
+	const uint64_t key = (uint64_t(m_maincpu->pc()) << 32) ^ (uint64_t(port) << 16) ^ (data & 0xffff);
+	if (seen.size() < 200 && seen.insert(key).second)
+		S3000_LOG("IO-UNMAPPED-W $%04X = %04X  mask=%04X pc=%05X t=%.4f\n",
+			port, data, mem_mask, m_maincpu->pc(), machine().time().as_double());
+}
+
+// [SAMPLING 76] THE RATE INCREMENT, which the decoded caller says is the whole story.
+//
+// The routine that calls the poll, dumped live at 027184h:
+//
+//   mov dx,bx                    save the increment
+//   add bp,[7904] / adc bx,[7906]    a 32-BIT position += a 32-bit increment
+//   sub bx,4000h / add bx,2000h / jnb   modulo the 8192-byte ring on the high word
+//   mov [7904],bp / mov [7906],bx     store the position back
+//   and bx,0FFFCh                align to four bytes
+//   call 0271B0                  is 800h ready?
+//   jb  0271AF                   no - return
+//   mov cx,dx / call 0270C6      yes - copy
+//   jmp 0271A3                   and ask again
+//
+// Two things follow and they explain everything measured. The loop repeats until avail falls BELOW
+// 800h, and in this emulation it never does, so the routine never returns - that is the freeze, and
+// the same loop running away is what fills the sample with re-read ring content. And the read pointer
+// does not step by words: it is a 32-bit fixed-point position advanced by an INCREMENT, which is how
+// this machine handles sample rates at all. If the increment is too small the position crawls through
+// the ring, the transfer laps it forever, and avail never comes down.
+//
+// The measured coverage says how much too small: a recording holds 25 per cent of the real input, so
+// the position advances at about a QUARTER of the rate it should. One number decides it, and it is
+// sitting in memory at 7904h.
+// [SAMPLING 86] see the note at drq_handler_cb.
+void s3000_state::dsp_drq_w(int state)
+{
+	// [SAMPLING 92] THE GATE IS OUT. Rate-limiting the sound chip's request during a recording made
+	// everything worse, not better: the monitor started late against the record button, the timing of
+	// the capture itself came apart, and the built-in waveforms turned sawtooth-like. Reverted, whole.
+	//
+	// It also taught something worth keeping. Three times now - SAMPLING 57, 60/61/68 on channel 2, and
+	// this one on channel 3 - a DMA request line has been paced from this side and every attempt has
+	// degraded the machine. The request is not a knob. Whatever sets how much a recording stores, it is
+	// not something to be throttled at the wire.
+	m_maincpu->dreq_w<3>(state);              // forward, unchanged
+
+	if (state) m_drq3_hi++; else m_drq3_lo++;
+	const double now = machine().time().as_double();
+	if (now - m_drq3_t >= 1.0)
+	{
+		m_drq3_t = now;
+		if (m_drq3_hi > 100)
+			S3000_LOG("DSP-DREQ3 rose %llu times, fell %llu, against %u words stored  t=%.3f\n",
+				(unsigned long long)m_drq3_hi, (unsigned long long)m_drq3_lo, m_sr_n, now);
+		m_drq3_hi = m_drq3_lo = 0;
+	}
+}
+
+// [SAMPLING 81] see the note at out_io16w_cb<3>.
+void s3000_state::sampleram_w(uint16_t data)
+{
+	m_dsp->dma_w16_cb(data);                  // forward first, unchanged
+
+	// [SAMPLING 106] WHAT LEVEL ACTUALLY REACHES THE SAMPLE? Thor's release blocker is that the capture
+	// is far too quiet - about 12 dB - and 12 dB is a factor of four, which is too round to be an
+	// accident. But it has to be attributed before it can be fixed, and there are two candidates:
+	//
+	//   the RECORDING is quiet   the converter or the transfer loses it, and the fix is on this side
+	//   the PLAYBACK is quiet    the stored sample is correct and the loss is after it, which is a
+	//                            different piece of work entirely
+	//
+	// The converter is already known to be right: ADC-PEAK measured float=0.5012 -> int=16422 for a
+	// -6 dB input, which is -6.0 dBFS to two decimals. So the level is correct as far as the converter.
+	// This takes it one stage further, at the point where the firmware STORES the word - past the DMA,
+	// before any playback, filter or output gain.
+	//
+	// Peak of the absolute value, reported once a second in dBFS. Send a known level in and the number
+	// says outright which half of the machine to look at.
+	const int32_t mag = (int16_t(data) < 0) ? -int32_t(int16_t(data)) : int32_t(int16_t(data));
+	if (mag > m_sr_peak) m_sr_peak = mag;
+
+	const int32_t d = int16_t(data) - int16_t(m_sr_prev);
+	m_sr_prev = data;
+	if (d == 1)      m_sr_step1++;
+	else if (d == 2) m_sr_step2++;   // [SAMPLING 113] one word per frame - the mono shape
+	else if (d == 0) m_sr_rep++;
+	else           { m_sr_jump++; if (std::abs(d) > std::abs(m_sr_worst)) m_sr_worst = d; }
+	m_sr_n++;
+
+	// [SAMPLING 82] DUMP THE COPY ROUTINE, once, the first time a word is stored at the 12x rate.
+	//
+	// The arithmetic is closed. In the second where the A/D delivered 44100 words the firmware stored
+	// 529200 - exactly twelve times as many - as an UNBROKEN +1 sequence: step+1 529068 of 529200,
+	// repeat 0, and 132 jumps, which is one every 4009 words against a ring of 4096. So the copy reads
+	// the ring round and round and writes twelve output words per input word, over the same
+	// destination, until the recording ends.
+	//
+	// That also explains why avail never falls: the position advances 88200 bytes a second, exactly the
+	// rate the transfer fills the ring, so the difference the loop tests is CONSTANT and the loop can
+	// never reach its exit. The runaway, the seams a ring long, the repeated content and the freeze are
+	// one fault.
+	//
+	// Per stored word the position advances 88200/529200 = 0.1667 bytes, which is 2AAAh in 16.16 where
+	// it should be 20000h - one word, two bytes. The increment is a twelfth of what it should be, and
+	// the routine that uses it is at 0270C6h. Dump it and the source of that number is in the open.
+	if (!m_sr_dumped && m_sr_n > 20000)
+	{
+		m_sr_dumped = true;
+		address_space &sp = m_maincpu->space(AS_PROGRAM);
+		for (int row = 0; row < 8; row++)
+		{
+			std::string bytes;
+			for (int i = 0; i < 16; i++)
+				bytes += util::string_format("%02X ", sp.read_byte(0x0270A0 + row * 16 + i));
+			S3000_LOG("COPY-CODE %06X: %s\n", 0x0270A0 + row * 16, bytes);
+		}
+	}
+
+	const double now = machine().time().as_double();
+	if (now - m_sr_t >= 1.0)
+	{
+		m_sr_t = now;
+		// [SAMPLING 83] DX IS THE BYTE COUNT, and it is the number this whole hunt has come down to.
+		//
+		// The copy at 0270C6h is decoded and it is a plain block move, not a rate conversion:
+		//
+		//   mov si,[78F0] / cmp against [78EE] / clamp cx to 2000h-si
+		//   mov di,si / add si,91B0h / add di,62AAh / mov es,3A60h
+		//   shr cx,1 / cld / rep movsw
+		//   wrap si at 2000h / mov [78F0],si
+		//
+		// So there is no interpolation anywhere - CX bytes are moved from the ring at 91B0h to 3A60:62AA
+		// and the source offset lives in [78F0]. Which means BX:BP at 027184h is not an increment at
+		// all: its high word is saved into DX and handed to the copy as the BYTE COUNT, and the same
+		// value advances the position. SAMPLING 76 and 82 called it an increment; it is a length.
+		//
+		// DX is untouched by the copy - rep movsw uses CX, SI, DI - so it holds that byte count for the
+		// whole loop and can simply be read here. One register, once a second.
+		if (m_sr_n > 100)
+			// [SAMPLING 113] step+2 is the mono shape and is named rather than lumped into jump.
+			S3000_LOG("SAMPLE-STORE %u words  PEAK %d = %.2f dBFS  (step+1 %.1f%%, step+2 %.1f%%, repeat %u, jump %u, worst %d)  t=%.3f\n",
+				m_sr_n, m_sr_peak,
+				m_sr_peak ? 20.0 * log10(double(m_sr_peak) / 32767.0) : -999.0,
+				m_sr_step1 * 100.0 / m_sr_n, m_sr_step2 * 100.0 / m_sr_n,
+				m_sr_rep, m_sr_jump, m_sr_worst, now);
+		m_sr_step1 = m_sr_step2 = m_sr_rep = m_sr_jump = m_sr_n = 0; m_sr_worst = 0; m_sr_peak = 0;
+	}
+}
+
+TIMER_CALLBACK_MEMBER(s3000_state::rateprobe_tick)
+{
+	// [SAMPLING 79] THE NUMBER THE WHOLE HUNT IS ABOUT. SAMPLING 78 found the position: DS is 0, so it
+	// really is at 007904h, and the structure is confirmed by the machine itself - the value read was
+	// 1B737CA8h while BX was 1B70h, which is exactly 1B73h masked with 0FFFCh. So it is 16.16 fixed
+	// point: the high word is the byte offset into the 8192-byte ring, the low word the fraction.
+	//
+	// In one second that position must advance 88200 bytes - 44100 words of two bytes - which is 10.77
+	// laps of the ring. Sampling at 1 kHz makes each step about 88 bytes, far below the 8192 wrap, so
+	// unwrapping is unambiguous and no advance can be missed.
+	//
+	// 88200 means the rate conversion is correct and the fault is elsewhere. About a quarter of it -
+	// which is what the 25 per cent coverage of a recording predicts - means the increment is wrong,
+	// and an increment is one value that can be traced to its source rather than a behaviour to be
+	// worked around.
+	address_space &sp = m_maincpu->space(AS_PROGRAM);
+	const uint32_t pos = uint32_t(sp.read_word(0x7904)) | (uint32_t(sp.read_word(0x7906)) << 16);
+	static uint32_t last = 0;
+	static uint64_t moved = 0;      // in 1/65536ths of a byte
+	static uint32_t n = 0;
